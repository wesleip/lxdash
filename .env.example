# =============================================================================
# docker-compose env file (project root)
#
# This file is read by `docker compose` for ${VAR} interpolation in
# docker-compose.yml. It is NOT loaded into containers — for that, see
# backend/.env.production (loaded via env_file:).
#
# Copy this file to ./.env and fill in real values. Never commit the real
# file (.gitignore blocks /.env).
# =============================================================================

# -------------------------------------------------------------------
# LXD host group GID
# The backend container needs to read /var/snap/lxd/common/lxd/unix.socket,
# which is owned by root:lxd with mode 0660. The host's lxd group usually
# is GID 101 on Debian-family distros, but varies. Find yours with:
#
#     getent group lxd | cut -d: -f3
#
# This value is used in two places in docker-compose.yml:
#   1. build.args.LXD_GID      → baked into the image at build time
#   2. services.backend.group_add → added to the process at runtime
#
# Setting it here lets the runtime group_add add the correct GID; no
# rebuild required for this variable alone.
# -------------------------------------------------------------------
LXD_GID=101