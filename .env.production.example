# =============================================================================
# lxdash — production environment
# Copy to backend/.env.production and fill in real values.
# Never commit .env.production to git.
# =============================================================================

# ---------------------------------------------------------------------------
# JWT / Auth — REQUIRED
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database
# Default: SQLite persisted at /app/data/lxdash.db (set in docker-compose.yml)
# For PostgreSQL: uncomment and configure the line below.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://lxdash:password@postgres:5432/lxdash

# ---------------------------------------------------------------------------
# LXD socket path (inside the container — matches the volume mount)
# ---------------------------------------------------------------------------
LXD_SOCKET_PATH=/var/snap/lxd/common/lxd/unix.socket

# ---------------------------------------------------------------------------
# CORS — set to the domain where nginx is running
# This MUST match the scheme actually served by nginx. If TLS is not yet
# enabled (nginx currently listens on :80), use "http://lxdash.yourdomain.com"
# here or browsers will block the frontend before it can authenticate.
# ---------------------------------------------------------------------------
CORS_ORIGINS=["https://lxdash.yourdomain.com"]

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LXD_MOCK=false
UVICORN_WORKERS=2

# ---------------------------------------------------------------------------
# First-boot admin seed (optional)
# If set, entrypoint.sh creates the admin user on first start.
# Remove or unset after the user is created.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
