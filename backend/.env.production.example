# =============================================================================
# lxdash backend — production env template
#
# This file is loaded into the backend CONTAINER via `env_file:` in
# docker-compose.yml. It is separate from the ./.env file at the project root,
# which is read by docker-compose itself for ${VAR} interpolation.
#
# Copy this file to backend/.env.production and fill in real values. Never
# commit the real file (.gitignore blocks it).
# =============================================================================

# -------------------------------------------------------------------
# Database
# SQLite for single-host; swap to postgres:// for multi-host / HA.
# -------------------------------------------------------------------
DATABASE_URL=sqlite:////app/data/lxdash.db
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/lxdash

# -------------------------------------------------------------------
# JWT / Auth
# Generate SECRET_KEY with: openssl rand -hex 32
# Backend refuses to boot in production with the placeholder value.
# -------------------------------------------------------------------
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ALGORITHM=HS256

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# LXD
# Path to the LXD Unix socket INSIDE the backend container. The host socket
# is bind-mounted at the same path in docker-compose.yml.
# -------------------------------------------------------------------
LXD_SOCKET_PATH=/var/snap/lxd/common/lxd/unix.socket

# -------------------------------------------------------------------
# CORS
# JSON array of allowed origins. Wildcards are forbidden in production.
# -------------------------------------------------------------------
CORS_ORIGINS=["https://your.domain"]

# -------------------------------------------------------------------
# First-boot admin user
# If ADMIN_PASSWORD is set, the entrypoint runs seed.py on first boot
# (idempotent — skips if the admin already exists). Unset this after the
# first successful boot to remove the credential from the container env.
# -------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-set-a-real-password
ADMIN_EMAIL=admin@your.domain

# -------------------------------------------------------------------
# Notifications (Discord webhook — optional)
# Leave DISCORD_WEBHOOK_URL empty to disable.
# Get the URL from Discord: Channel Settings → Integrations → Webhooks.
# -------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdef...
DISCORD_NOTIFY_USERNAME=lxDash
DISCORD_NOTIFY_ON_SUCCESS=true
DISCORD_NOTIFY_ON_FAILURE=true
DISCORD_NOTIFY_ACTIONS=*
DISCORD_NOTIFY_TIMEOUT_SECONDS=5

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# MUST be false in production. LXD_MOCK=true serves in-memory fake data and
# the boot guard in config.py refuses it.
LXD_MOCK=false

# Interactive API docs (/docs, /redoc, /openapi.json).
# Set to false when the instance is reachable from an untrusted network.
DOCS_ENABLED=false